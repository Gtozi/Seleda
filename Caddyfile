# global options
{
	admin off
	persist_config off
	auto_https off
	log {
		format json
	}
	servers {
		trusted_proxies static private_ranges 100.0.0.0/8
	}
}

# Admin subdomain - routes to admin portal
admin.seledabet.com {
	log {
		format json
	}

	rewrite /health /*

	reverse_proxy localhost:3001
}

# Main domain - handles all other requests
seledabet.com, www.seledabet.com, *.seledabet.com {
	log {
		format json
	}

	# health check
	rewrite /health /*

	# Proxy ALL requests to Express server (handles API + static files)
	reverse_proxy localhost:3001
}
