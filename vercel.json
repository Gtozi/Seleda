{
  "version": 2,
   "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": null,
  "routes": [ 
    {
        "handle": "filesystem"
    },
    {
       "src": "/api/(.*)",
      "dest": "/dist/$1"
    },
     {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
 "functions": {
    "api/**/*.ts": {
      "runtime": "nodejs20.x"
    }
  }
}